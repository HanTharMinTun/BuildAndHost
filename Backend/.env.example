# Marketku API Configuration
# Copy this file to .env and fill in your actual API key

# Your Marketku API key (starts with sk-8b1e29c499ff470f...)
MARKETKU_API_KEY=sk-8b1e29c499ff470f-f7zw3y-d9e7e286

# Marketku API base URL
MARKETKU_BASE_URL=https://router.marketku.id/v1

# Model to use for website generation
# Options:
#   - mk/sonnet-4.5-thinking-agentic (recommended for complex reasoning)
#   - mk/sonnet-4.5-agentic (good balance)
#   - mk/sonnet-4.5-thinking (reasoning focused)
#   - mk/sonnet-4.5 (fastest, most cost-effective)
MARKETKU_MODEL=mk/sonnet-4.5-thinking-agentic

# Default temperature for API calls (0.0 to 1.0)
# Lower values are more deterministic, higher values more creative
DEFAULT_TEMPERATURE=0.6

# Default maximum tokens for API responses
DEFAULT_MAX_TOKENS=2048

# Google OAuth Configuration
# Get these credentials from https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URIs:
#    - http://localhost:5173 (for local development)
#    - https://yourdomain.com (for production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
